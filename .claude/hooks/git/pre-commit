#!/usr/bin/env bash
# Reject a commit that a Claude Code session would attribute to a person.
#
# The remote session's clone is configured to commit as the agent. A command
# that supplies `-c user.email=...`, or an environment that sets GIT_AUTHOR_EMAIL,
# silently replaces that identity, and GitHub then shows the commit as
# Unverified under a person's name. This hook makes that failure loud.
#
# `session-start.sh` installs it through `core.hooksPath`, and only in a remote
# session, so a local contributor keeps their own identity and their own hooks.
#
# Fail-safe: when the author cannot be determined the commit is allowed. This
# hook exists to catch a wrong identity, never to block work.
set -uo pipefail

expected="${CLAUDE_GIT_AUTHOR_EMAIL:-noreply@anthropic.com}"

ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
actual="$(printf '%s' "$ident" | sed -n 's/^.*<\([^>]*\)>.*$/\1/p')"

if [ -z "$actual" ] || [ "$actual" = "$expected" ]; then
  exit 0
fi

cat >&2 <<MSG
pre-commit: refusing to commit as <${actual}>.

This session must author commits as <${expected}>. A commit made under a
person's address is shown as Unverified and misattributes the agent's work.

Do not pass '-c user.email=...' or '-c user.name=...' to git. The clone is
already configured correctly; run 'git commit' without an identity override.
MSG
exit 1
